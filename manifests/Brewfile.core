# Curated development baseline, derived from explicitly requested Homebrew formulae.
# Runtime versions are managed by mise. Miniforge and fnm are deliberately omitted.
tap "anomalyco/tap"
tap "neurosnap/tap"

brew "age"
brew "bat"
brew "btop"
brew "cmake"
brew "chezmoi"
brew "curl"
brew "eza"
brew "fd"
brew "fish"
brew "fisher"
brew "fzf"
brew "gh"
brew "git"
brew "git-delta"
brew "glow"
brew "gnupg"
brew "jq"
brew "lazygit"
brew "mise"
brew "nano"
brew "neovim"
brew "pinentry-mac"
brew "ripgrep"
brew "tmux"
brew "tree"
brew "uv"
brew "wget"
brew "yq"
brew "zoxide"
brew "anomalyco/tap/opencode", trusted: true
brew "neurosnap/tap/zmx", trusted: true
