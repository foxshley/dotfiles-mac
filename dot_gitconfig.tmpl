# Personal identity is supplied through chezmoi's local, untracked config data.
[user]
{{ if get . "git_name" }}
	name = {{ get . "git_name" | quote }}
{{ end }}{{ if get . "git_email" }}
	email = {{ get . "git_email" | quote }}
{{ end }}{{ if get . "git_signingkey" }}
	signingkey = {{ get . "git_signingkey" | quote }}
{{ end }}

[gpg]
	program = gpg

[commit]
	gpgsign = {{ if get . "git_signingkey" }}true{{ else }}false{{ end }}

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictStyle = zdiff3
